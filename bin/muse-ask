#!/usr/bin/env bash
# muse-ask: delegate a research or test brief to Muse. The work is in lib/muse_ask.py;
# this wrapper only finds a Python that really runs (see lib/find-python.sh).
root="$(cd "${0%/*}/.." && pwd)"
. "$root/lib/find-python.sh"
if [ -z "$PY" ]; then
  echo "muse-ask: Python 3.8+ not found (tried python3, python, py -3)" >&2
  exit 127
fi
exec $PY "$root/lib/muse_ask.py" "$@"
