#!/usr/bin/env python3
"""muse-ask: run Muse (Meta's Muse Spark coding agent) headless on behalf of Claude.

Muse does the reading, searching and test running. Only its final report and one
footer line reach stdout, so the bulk of the work never enters Claude's context.
Every tool output Muse saw is kept in a markdown log (plus the raw event stream)
under ~/.cache/clawmuse/runs, for spot checks without re-running anything.

Muse runs inside its own sandbox with approvals off (headless). On machines where
that sandbox cannot start, the user can opt in to unsandboxed runs with
CLAWMUSE_YOLO=1, which passes `--yolo` to Muse.

Exit codes: 0 report delivered, 1 muse failed, 2 usage error, 124 timeout,
127 muse not found, 143 interrupted.
"""

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

EFFORTS = ('none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra')
LOG_KEEP_DAYS = 7
DEPTH_ENV = 'CLAWMUSE_DEPTH'
YOLO_ENV = 'CLAWMUSE_YOLO'
SANDBOX_ERRORS = ('bwrap:', 'sandbox-exec:')

HEADER = """You are a delegated worker for another AI coding agent (Claude). Claude reads ONLY your final message and pays for every word of it; nobody reads your intermediate steps. Make the final message dense, precise and self-contained."""

MODE_RULES = {
    'research': """MODE: RESEARCH (read-only). Investigate with file reads, search, read-only shell commands (ls, grep, rg, find, git log/show/diff/blame, cat, docker ps/logs/inspect) and web tools. Do NOT create, modify, move or delete files, and do NOT run anything that changes state: no installs, no git commit/checkout/reset/stash, no docker restart/rm/exec that writes, no migrations, no writes to databases or services.""",
    'test': """MODE: TEST. You may run tests, builds, linters, type checks, containers and scripts the task needs, and create throwaway files under /tmp only. Do NOT edit source files, commit, push, deploy or restart production services unless the task explicitly says so. Let long commands finish; report hangs or timeouts instead of retrying endlessly.""",
}

REPORT_RULES = """FINAL MESSAGE RULES:
- Answer first. No greeting, no restating the task, no narration of what you did.
- Evidence: path:line for code facts (plain text, paths relative to the workspace, no markdown links), the exact command for anything you ran, the URL for web facts. Quote only the few lines that matter; never paste whole files or logs.
- Separate verified facts from inference; label anything you did not check as "unverified". If you could not do something, say what and why.
- Tests/builds: the exact command, pass/fail/skip counts, then each failure as `test name - path:line - key error line`, plus a one-line likely cause when evident.
- At most ~{words} words unless the task explicitly asks for more. Terse bullets. English."""


def build_prompt(mode, brief, words, follow_up):
    parts = [HEADER, MODE_RULES[mode], REPORT_RULES.format(words=words)]
    if follow_up:
        parts.append('FOLLOW-UP in the same session: reuse what you already learned; do not redo work.')
    parts.append('TASK:\n' + brief.strip())
    return '\n\n'.join(parts) + '\n'


def parse_args(argv):
    ap = argparse.ArgumentParser(
        prog='muse-ask',
        description='Delegate a research or test brief to Muse; print only its report.')
    ap.add_argument('-m', '--mode', choices=sorted(MODE_RULES), default='research',
                    help='research: read-only (default). test: may run commands.')
    ap.add_argument('-C', '--dir', default='.', help='workspace for Muse (default: cwd)')
    ap.add_argument('-e', '--effort', choices=EFFORTS,
                    help="Muse reasoning effort (default: Muse's own setting)")
    ap.add_argument('-w', '--words', type=int, default=300, help='report word budget (default 300)')
    ap.add_argument('-t', '--timeout', type=int, default=540,
                    help='seconds before Muse is stopped (default 540)')
    ap.add_argument('-c', '--continue', dest='session', metavar='SESSION',
                    help='follow-up in an earlier Muse session (id from the footer)')
    ap.add_argument('-s', '--steps', type=int, help='cap Muse model steps')
    ap.add_argument('-i', '--image', action='append', default=[], help='attach an image (repeatable)')
    ap.add_argument('brief', nargs='*', help="the brief; '-' or nothing reads stdin")
    return ap.parse_args(argv)


def read_brief(words):
    if words and words != ['-']:
        return ' '.join(words)
    if sys.stdin.isatty():
        return ''
    return sys.stdin.read()


def log_dir():
    base = os.environ.get('XDG_CACHE_HOME') or os.path.join(os.path.expanduser('~'), '.cache')
    path = Path(base) / 'clawmuse' / 'runs'
    path.mkdir(parents=True, exist_ok=True)
    return path


def prune(path):
    cutoff = time.time() - LOG_KEEP_DAYS * 86400
    for f in path.iterdir():
        try:
            if f.stat().st_mtime < cutoff:
                f.unlink()
        except OSError:
            pass


class Run:
    """Collects what matters from Muse's JSONL event stream."""

    def __init__(self):
        self.session = None
        self.model = None
        self.tools = []          # (name, outcome, text)
        self.tail = []           # output deltas since the last tool result
        self.terminal = None
        self.reason = None
        self.final = None
        self.sandbox_failed = False

    def feed(self, line):
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if not isinstance(ev, dict):
            return
        stream = ev.get('stream') or {}
        if not self.session and stream.get('kind') == 'session':
            self.session = stream.get('id')
        p = ev.get('payload')
        if not isinstance(p, dict):
            return
        kind = ev.get('payload_type', '')
        if kind == 'run.model.configured':
            self.model = p.get('model_id')
        elif kind == 'tool.result':
            facts = p.get('correlation_facts') or {}
            text = p.get('text') or ''
            self.tools.append((facts.get('tool_name') or '?', facts.get('outcome') or '?', text))
            self.tail = []
            if any(e in text for e in SANDBOX_ERRORS):
                self.sandbox_failed = True
        elif kind == 'run.output.delta':
            self.tail.append(p.get('text') or '')
        elif p.get('kind') == 'run_terminal':
            self.terminal = p.get('terminal')
            self.reason = p.get('reason')
            self.final = p.get('text')

    def report(self):
        return (self.final if self.final is not None else ''.join(self.tail)).strip()

    def chars_read(self):
        return sum(len(t) for _, _, t in self.tools)


def kchars(n):
    return f'{n / 1000:.1f}k' if n >= 1000 else str(n)


def tool_block(i, name, outcome, text):
    head = f'### {i}. {name} - {outcome} - {kchars(len(text))} chars\n'
    try:
        obj = json.loads(text)
    except ValueError:
        obj = None
    if isinstance(obj, dict) and 'command' in obj:
        body = f"$ {obj.get('command')}\nexit: {obj.get('exit_code')}\n{obj.get('output', '')}"
    else:
        body = text
    return head + '```text\n' + body.replace('```', "'''") + '\n```\n'


def write_log(path, args, wd, brief, run, elapsed, status, yolo):
    lines = [
        f'# muse-ask {args.mode} ({"yolo" if yolo else "sandboxed"}) - {time.strftime("%Y-%m-%d %H:%M:%S")}',
        f'workspace: {wd}',
        f'session: {run.session} | model: {run.model} | {elapsed:.0f}s | status: {status}',
        '', '## Brief', brief.strip(), '', f'## Tool calls ({len(run.tools)})', '',
    ]
    for i, (name, outcome, text) in enumerate(run.tools, 1):
        lines.append(tool_block(i, name, outcome, text))
    lines += ['## Final report', run.report() or '(none)', '']
    path.write_text('\n'.join(lines), encoding='utf-8')


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)

    if os.environ.get(DEPTH_ENV):
        print('muse-ask: refusing nested delegation (already running inside Muse); do the work yourself.',
              file=sys.stderr)
        return 2

    brief = read_brief(args.brief)
    if not brief.strip():
        print('muse-ask: empty brief (pass it as arguments or on stdin)', file=sys.stderr)
        return 2
    if args.words < 20 or args.timeout < 1:
        print('muse-ask: --words must be >= 20 and --timeout >= 1', file=sys.stderr)
        return 2

    wd = Path(args.dir).expanduser().resolve()
    if not wd.is_dir():
        print(f'muse-ask: workspace not found: {wd}', file=sys.stderr)
        return 2

    muse = shutil.which(os.environ.get('CLAWMUSE_MUSE', 'muse'))
    if not muse:
        print('muse-ask: muse CLI not found on PATH (install Muse Code or set CLAWMUSE_MUSE)', file=sys.stderr)
        return 127

    logs = log_dir()
    prune(logs)
    stem = f'{time.strftime("%Y%m%d-%H%M%S")}-{args.mode}-{os.getpid()}'
    md_path, raw_path, err_path = (logs / f'{stem}{ext}' for ext in ('.md', '.jsonl', '.err'))

    with tempfile.NamedTemporaryFile('w', suffix='.txt', prefix='clawmuse-', delete=False,
                                     encoding='utf-8') as pf:
        pf.write(build_prompt(args.mode, brief, args.words, bool(args.session)))
        prompt_file = pf.name

    yolo = os.environ.get(YOLO_ENV, '').strip().lower() in ('1', 'true', 'yes', 'on')
    cmd = [muse, 'exec', '--json', '--prompt-file', prompt_file]
    cmd += ['--yolo'] if yolo else ['--trust-workspace', '--approval-mode', 'never']
    if args.mode == 'research':
        cmd.append('--disable-write')
    if args.effort:
        cmd += ['--reasoning-effort', args.effort]
    if args.steps:
        cmd += ['--max-model-steps', str(args.steps)]
    if args.session:
        cmd += ['--session-id', args.session]
    for img in args.image:
        cmd += ['--image', str(Path(img).expanduser().resolve())]

    env = dict(os.environ, **{DEPTH_ENV: '1'})
    run = Run()
    started = time.monotonic()
    state = {'timed_out': False, 'interrupted': False}

    with open(raw_path, 'w', encoding='utf-8') as raw, open(err_path, 'w', encoding='utf-8') as err:
        proc = subprocess.Popen(cmd, cwd=wd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=err, text=True, encoding='utf-8', errors='replace',
                                start_new_session=True)

        def stop(reason):
            # TERM the whole group (launcher, muse, its shells), then KILL stragglers
            # that could otherwise keep the stdout pipe open.
            state[reason] = True
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                return
            try:
                proc.wait(5)
            except subprocess.TimeoutExpired:
                pass
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

        def on_signal(signum, _frame):
            stop('interrupted')

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, on_signal)
        timer = threading.Timer(args.timeout, stop, ('timed_out',))
        timer.daemon = True
        timer.start()
        try:
            for line in proc.stdout:
                raw.write(line)
                run.feed(line)
            proc.wait()
        finally:
            timer.cancel()
            os.unlink(prompt_file)

    elapsed = time.monotonic() - started
    if state['interrupted']:
        status, code = 'interrupted', 143
    elif state['timed_out']:
        status, code = f'timeout after {args.timeout}s', 124
    elif run.terminal == 'completed':
        status, code = 'completed', 0
    else:
        status = run.terminal or f'muse exited {proc.returncode} without a result'
        if run.reason:
            status += f' ({run.reason})'
        code = 1
    write_log(md_path, args, wd, brief, run, elapsed, status, yolo)

    out = run.report()
    if code:
        out = f'MUSE {status.upper()}.' + (f' Partial output:\n{out}' if out else '')
        err_tail = [l for l in err_path.read_text(encoding='utf-8', errors='replace').splitlines()
                    if l.strip() and not l.startswith('muse: workspace ')][-5:]
        if err_tail and code != 124:
            out += '\nmuse stderr:\n' + '\n'.join(err_tail)
        if run.session and code in (1, 124):
            out += f'\nResume with: muse-ask -c {run.session} "<what to finish>"'
    if run.sandbox_failed and not yolo:
        out += ('\nNOTE: Muse\'s shell sandbox cannot start on this machine, so its shell commands failed. '
                f'The user can allow unsandboxed Muse runs by setting {YOLO_ENV}=1 (see the clawmuse README); '
                'do not set it yourself, tell the user.')
    footer = (f'[muse · {args.mode} · {elapsed:.0f}s · {len(run.tools)} tools, '
              f'{kchars(run.chars_read())} chars read · session {run.session} · log {md_path}]')
    print(f'{out}\n\n{footer}')
    return code


if __name__ == '__main__':
    sys.exit(main())
